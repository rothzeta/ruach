{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "skills/*/scripts/**/*.ts", "skills/*/tests/**/*.ts"]
}
