import { expect, test } from 'bun:test';
import { inclusiveRange, rangeSize } from '../src/range';

test('includes both endpoints', () => {
  expect(inclusiveRange(1, 3)).toEqual([1, 2, 3]);
});
test('a single value range has one element', () => {
  expect(inclusiveRange(4, 4)).toEqual([4]);
  expect(rangeSize(4, 4)).toBe(1);
});
test('a reversed range is empty', () => {
  expect(inclusiveRange(5, 2)).toEqual([]);
  expect(rangeSize(5, 2)).toBe(0);
});
test('size counts both endpoints', () => {
  expect(rangeSize(0, 9)).toBe(10);
});
